{"id":"luna-02-001","source":"gpt-5.6-luna","category":"web","messages":[{"role":"user","content":"Make a responsive counter card with plus, minus, and reset buttons."},{"role":"assistant","content":"Save this as index.html and open it in a browser.\n```html\n<!doctype html><meta name=viewport content=\"width=device-width,initial-scale=1\"><style>body{font:18px system-ui;display:grid;place-items:center;min-height:100vh;background:#eef2ff}.card{background:white;padding:2rem;border-radius:16px;text-align:center;box-shadow:0 8px 30px #0002}button{font-size:1.2rem;padding:.5rem 1rem;margin:.25rem;border:0;border-radius:8px;background:#4f46e5;color:white}</style><main class=card><h1>Counter</h1><output id=n>0</output><p><button data-step=-1>−</button><button data-step=1>+</button><button id=reset>Reset</button></p></main><script>let value=0;const n=document.querySelector('#n');function draw(){n.textContent=value}document.querySelectorAll('[data-step]').forEach(b=>b.onclick=()=>{value+=+b.dataset.step;draw()});reset.onclick=()=>{value=0;draw()};draw();</script>\n```"}]}
{"id":"luna-02-002","source":"gpt-5.6-luna","category":"web","messages":[{"role":"user","content":"Build a dark-mode toggle that remembers the preference."},{"role":"assistant","content":"Use this single file. It stores the choice in localStorage and respects the OS on first visit.\n```html\n<!doctype html><style>:root{font:18px system-ui;color-scheme:light}body{margin:0;padding:3rem;max-width:50rem;background:#fff;color:#111}body.dark{background:#111827;color:#f9fafb}button{padding:.6rem 1rem;border-radius:8px;border:1px solid currentColor;background:transparent;color:inherit}</style><main><button id=toggle>Toggle theme</button><h1>Readable page</h1><p>The theme persists after reload.</p></main><script>const key='theme',saved=localStorage.getItem(key);if(saved)document.body.className=saved;else if(matchMedia('(prefers-color-scheme:dark)').matches)document.body.className='dark';toggle.onclick=()=>{document.body.classList.toggle('dark');localStorage.setItem(key,document.body.className)};</script>\n```"}]}
{"id":"luna-02-003","source":"gpt-5.6-luna","category":"web","messages":[{"role":"user","content":"Create a todo list with add, complete, delete, and persistent storage."},{"role":"assistant","content":"Here is a keyboard-friendly todo app.\n```html\n<!doctype html><style>body{font:16px system-ui;max-width:600px;margin:3rem auto;padding:1rem}form{display:flex;gap:.5rem}input{flex:1;padding:.7rem}button{padding:.55rem}.done{text-decoration:line-through;opacity:.55}li{display:flex;gap:.6rem;align-items:center;padding:.6rem 0}li span{flex:1}</style><h1>Tasks</h1><form id=form><input id=text required placeholder=\"New task\"><button>Add</button></form><ul id=list></ul><script>let items=JSON.parse(localStorage.tasks||'[]');function save(){localStorage.tasks=JSON.stringify(items);render()}function render(){list.innerHTML=items.map((x,i)=>`<li><input type=checkbox ${x.done?'checked':''} data-i=${i}><span class=${x.done?'done':''}>${x.text.replace(/[&<>]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]))}</span><button data-del=${i}>Delete</button></li>`).join('')}form.onsubmit=e=>{e.preventDefault();items.push({text:text.value,done:false});text.value='';save()};list.onclick=e=>{let i=e.target.dataset.i;if(i!==undefined){items[i].done=e.target.checked;save()}if(e.target.dataset.del){items.splice(e.target.dataset.del,1);save()}};render()</script>\n```"}]}
{"id":"luna-02-004","source":"gpt-5.6-luna","category":"web","messages":[{"role":"user","content":"Make a live character counter for a textarea with a 160 character limit."},{"role":"assistant","content":"This version prevents typing beyond the limit and updates an accessible status.\n```html\n<!doctype html><style>body{font:18px system-ui;max-width:35rem;margin:3rem auto;padding:1rem}textarea{width:100%;box-sizing:border-box;padding:1rem;border:2px solid #64748b;border-radius:10px}#status{color:#475569}.warn{color:#dc2626!important}</style><h1>Short message</h1><textarea id=msg maxlength=160 rows=6 aria-describedby=status></textarea><p id=status aria-live=polite>160 characters left</p><script>msg.oninput=()=>{let left=160-msg.value.length;status.textContent=left+' characters left';status.classList.toggle('warn',left<20)}</script>\n```"}]}
{"id":"luna-02-005","source":"gpt-5.6-luna","category":"web","messages":[{"role":"user","content":"Build a searchable table of contacts with a no-results message."},{"role":"assistant","content":"The filter checks every visible column and keeps the table responsive.\n```html\n<!doctype html><style>body{font:16px system-ui;margin:2rem}input{padding:.7rem;width:min(100%,25rem);margin-bottom:1rem}table{border-collapse:collapse;width:100%}th,td{padding:.7rem;text-align:left;border-bottom:1px solid #ddd}.wrap{overflow:auto}</style><h1>Contacts</h1><input id=q placeholder=\"Search name, email, or city\"><div class=wrap><table><thead><tr><th>Name</th><th>Email</th><th>City</th></tr></thead><tbody id=rows></tbody></table></div><p id=empty hidden>No matches.</p><script>const data=[['Ari Chen','ari@example.com','Perth'],['Mina Rao','mina@example.com','Sydney'],['Jon Bell','jon@example.com','Melbourne']];function render(){let term=q.value.toLowerCase();let found=data.filter(r=>r.join(' ').toLowerCase().includes(term));rows.innerHTML=found.map(r=>'<tr>'+r.map(c=>'<td>'+c+'</td>').join('')+'</tr>').join('');empty.hidden=found.length>0}q.oninput=render;render()</script>\n```"}]}
{"id":"luna-02-006","source":"gpt-5.6-luna","category":"web","messages":[{"role":"user","content":"Create an accessible modal dialog opened by a button and closed by escape or backdrop."},{"role":"assistant","content":"Native dialog gives keyboard behavior; the script adds the requested close paths.\n```html\n<!doctype html><style>body{font:18px system-ui;padding:3rem}dialog{border:0;border-radius:14px;padding:2rem;box-shadow:0 10px 40px #0005}dialog::backdrop{background:#0008}button{padding:.6rem 1rem}</style><button id=open>Show details</button><dialog id=box><h2>Details</h2><p>This content is in a modal dialog.</p><button id=close>Close</button></dialog><script>open.onclick=()=>box.showModal();close.onclick=()=>box.close();box.addEventListener('click',e=>{if(e.target===box)box.close()});box.addEventListener('cancel',()=>box.close())</script>\n```"}]}
{"id":"luna-02-007","source":"gpt-5.6-luna","category":"web","messages":[{"role":"user","content":"Make a color picker that shows the selected hex value and copies it."},{"role":"assistant","content":"The copy button gives feedback without needing a library.\n```html\n<!doctype html><style>body{font:18px system-ui;display:grid;place-items:center;min-height:100vh}.card{padding:2rem;border:1px solid #ddd;border-radius:16px}input{width:8rem;height:4rem;vertical-align:middle}button{padding:.6rem}</style><main class=card><h1>Pick a color</h1><input id=color type=color value=\"#4f46e5\"><output id=value></output><button id=copy>Copy</button><p id=note aria-live=polite></p></main><script>function show(){value.textContent=color.value}color.oninput=show;copy.onclick=async()=>{await navigator.clipboard.writeText(color.value);note.textContent='Copied '+color.value};show()</script>\n```"}]}
{"id":"luna-02-008","source":"gpt-5.6-luna","category":"web","messages":[{"role":"user","content":"Build a stopwatch with start, pause, and reset."},{"role":"assistant","content":"This uses elapsed timestamps so it stays accurate when the tab is busy.\n```html\n<!doctype html><style>body{font:20px system-ui;text-align:center;padding:3rem;background:#0f172a;color:white}#time{font-size:4rem;font-variant-numeric:tabular-nums}button{padding:.7rem 1rem;margin:.25rem;border:0;border-radius:8px}</style><div id=time>00:00.0</div><button id=start>Start</button><button id=pause>Pause</button><button id=reset>Reset</button><script>let began=0,elapsed=0,timer;function format(ms){let m=Math.floor(ms/60000),s=Math.floor(ms%60000/1000),d=Math.floor(ms%1000/100);return String(m).padStart(2,'0')+':'+String(s).padStart(2,'0')+'.'+d}function draw(){time.textContent=format(elapsed+(began?Date.now()-began:0))}start.onclick=()=>{if(!began){began=Date.now();timer=setInterval(draw,80)}};pause.onclick=()=>{if(began){elapsed+=Date.now()-began;began=0;clearInterval(timer);draw()}};reset.onclick=()=>{began=0;elapsed=0;clearInterval(timer);draw()}</script>\n```"}]}
{"id":"luna-02-009","source":"gpt-5.6-luna","category":"web","messages":[{"role":"user","content":"Create tabs that switch panels and expose the selected tab to screen readers."},{"role":"assistant","content":"The ARIA relationships mirror the active state.\n```html\n<!doctype html><style>body{font:18px system-ui;max-width:40rem;margin:3rem auto}.tabs{display:flex;gap:.3rem}button{padding:.7rem;border:0}button[aria-selected=true]{background:#4f46e5;color:white}section{padding:1rem;border:1px solid #ddd}</style><div class=tabs role=tablist><button role=tab aria-selected=true aria-controls=p1 id=t1>Overview</button><button role=tab aria-selected=false aria-controls=p2 id=t2>Specs</button></div><section role=tabpanel id=p1 aria-labelledby=t1>Overview content.</section><section role=tabpanel id=p2 aria-labelledby=t2 hidden>Specifications content.</section><script>document.querySelectorAll('[role=tab]').forEach(tab=>tab.onclick=()=>{document.querySelectorAll('[role=tab]').forEach(t=>t.setAttribute('aria-selected',t===tab));document.querySelectorAll('[role=tabpanel]').forEach(p=>p.hidden=p.id!==tab.getAttribute('aria-controls'))})</script>\n```"}]}
{"id":"luna-02-010","source":"gpt-5.6-luna","category":"web","messages":[{"role":"user","content":"Make a small form that validates email and password inline."},{"role":"assistant","content":"Use native constraints plus a submit message for a clear result.\n```html\n<!doctype html><style>body{font:17px system-ui;max-width:28rem;margin:3rem auto;padding:1rem}label{display:block;margin:.8rem 0}input{display:block;width:100%;box-sizing:border-box;padding:.65rem;margin-top:.3rem}button{padding:.7rem 1rem}#result{margin-top:1rem}</style><form id=form><h1>Sign in</h1><label>Email<input id=email type=email required autocomplete=email></label><label>Password<input id=password type=password minlength=8 required></label><button>Continue</button><p id=result aria-live=polite></p></form><script>form.onsubmit=e=>{e.preventDefault();if(!form.reportValidity())return;result.textContent='Form is valid and ready to submit.'}</script>\n```"}]}
{"id":"luna-02-011","source":"gpt-5.6-luna","category":"web","messages":[{"role":"user","content":"Build a progress bar controlled by a range slider."},{"role":"assistant","content":"The progress element and text value stay synchronized.\n```html\n<!doctype html><style>body{font:18px system-ui;max-width:35rem;margin:3rem auto}progress{width:100%;height:1.5rem}input{width:100%}</style><h1>Upload progress</h1><progress id=bar value=35 max=100></progress><p><output id=out>35%</output></p><input id=slider type=range min=0 max=100 value=35><script>slider.oninput=()=>{bar.value=slider.value;out.value=slider.value+'%'}</script>\n```"}]}
{"id":"luna-02-012","source":"gpt-5.6-luna","category":"web","messages":[{"role":"user","content":"Create a collapsible FAQ list where only one answer is open."},{"role":"assistant","content":"Native details elements make this usable without JavaScript; this script enforces one open item.\n```html\n<!doctype html><style>body{font:18px system-ui;max-width:45rem;margin:3rem auto;padding:1rem}details{border-bottom:1px solid #ddd;padding:1rem 0}summary{cursor:pointer;font-weight:700}</style><h1>FAQ</h1><details open><summary>What is this?</summary><p>A compact FAQ component.</p></details><details><summary>Does it need a framework?</summary><p>No, it is plain HTML, CSS, and JavaScript.</p></details><details><summary>Is it keyboard friendly?</summary><p>Yes, summary elements are focusable.</p></details><script>document.querySelectorAll('details').forEach(d=>d.ontoggle=()=>{if(d.open)document.querySelectorAll('details').forEach(x=>{if(x!==d)x.open=false})})</script>\n```"}]}
{"id":"luna-02-013","source":"gpt-5.6-luna","category":"web","messages":[{"role":"user","content":"Make a tiny image gallery with next and previous controls."},{"role":"assistant","content":"The gallery uses inline SVG data images, so it runs offline.\n```html\n<!doctype html><style>body{font:18px system-ui;text-align:center;padding:2rem;background:#f8fafc}img{width:min(90vw,500px);height:280px;object-fit:cover;border-radius:14px}button{padding:.7rem 1rem;margin:.5rem}</style><h1>Gallery</h1><img id=photo alt=\"Gallery image\"><p><button id=prev>Previous</button><output id=count></output><button id=next>Next</button></p><script>const pics=['data:image/svg+xml,<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"600\" height=\"300\"><rect width=\"100%\" height=\"100%\" fill=\"%23fca5a5\"/><text x=\"50%\" y=\"55%\" text-anchor=\"middle\" font-size=\"40\">One</text></svg>','data:image/svg+xml,<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"600\" height=\"300\"><rect width=\"100%\" height=\"100%\" fill=\"%2393c5fd\"/><text x=\"50%\" y=\"55%\" text-anchor=\"middle\" font-size=\"40\">Two</text></svg>'];let i=0;function draw(){photo.src=pics[i];count.textContent=` ${i+1} / ${pics.length} `}next.onclick=()=>{i=(i+1)%pics.length;draw()};prev.onclick=()=>{i=(i+pics.length-1)%pics.length;draw()};draw()</script>\n```"}]}
{"id":"luna-02-014","source":"gpt-5.6-luna","category":"web","messages":[{"role":"user","content":"Build a sortable list of products by name or price."},{"role":"assistant","content":"Click a heading to sort ascending, then click again to reverse.\n```html\n<!doctype html><style>body{font:17px system-ui;max-width:42rem;margin:3rem auto}table{width:100%;border-collapse:collapse}th,td{padding:.7rem;border-bottom:1px solid #ddd;text-align:left}th{cursor:pointer}</style><h1>Products</h1><table><thead><tr><th data-key=name>Name ↕</th><th data-key=price>Price ↕</th></tr></thead><tbody id=body></tbody></table><script>let products=[{name:'Notebook',price:12},{name:'Lamp',price:35},{name:'Mug',price:8}],key='name',dir=1;function draw(){body.innerHTML=[...products].sort((a,b)=>a[key]>b[key]?dir:-dir).map(x=>`<tr><td>${x.name}</td><td>$${x.price}</td></tr>`).join('')}document.querySelectorAll('th').forEach(h=>h.onclick=()=>{let k=h.dataset.key;dir=k===key?-dir:1;key=k;draw()});draw()</script>\n```"}]}
{"id":"luna-02-015","source":"gpt-5.6-luna","category":"web","messages":[{"role":"user","content":"Create a toast notification component with an auto-dismiss timer."},{"role":"assistant","content":"The live region announces messages and the close button remains available.\n```html\n<!doctype html><style>body{font:18px system-ui;padding:3rem}button{padding:.7rem 1rem}.toast{position:fixed;right:1rem;bottom:1rem;background:#111827;color:white;padding:1rem 1.2rem;border-radius:10px;box-shadow:0 5px 20px #0004}.toast button{background:transparent;color:white;border:0;font-size:1.2rem}</style><button id=show>Show notification</button><div id=region aria-live=polite></div><script>show.onclick=()=>{region.innerHTML='<div class=toast role=status>Saved successfully <button aria-label=\"Close\">×</button></div>';let toast=region.firstElementChild;let timer=setTimeout(()=>region.replaceChildren(),4000);toast.querySelector('button').onclick=()=>{clearTimeout(timer);region.replaceChildren()}}</script>\n```"}]}
